def text_value(dataset):
    if dataset is None:
        return None
    try:
        raw = dataset[0]
    except Exception:
        return None
    if raw is None:
        return None
    if isinstance(raw, bytes):
        return raw.decode("ascii", errors="replace")
    return str(raw)

